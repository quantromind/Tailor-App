# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# Secret used to sign auth JWTs — use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay API keys
# Test mode keys start with rzp_test_. Get them from the Razorpay Dashboard:
# https://dashboard.razorpay.com/app/keys
#
# To go live, replace these two values with your rzp_live_ keys. No code
# changes are required — the whole payment flow reads keys from here only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
